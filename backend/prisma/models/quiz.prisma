model Quiz {
  id        String @id @default(cuid())
  title     String
  createdBy String
  quizData  Json

  creator User @relation(fields:[createdBy],    references: [id] )

  liveQuizSessions LiveQuizSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
}