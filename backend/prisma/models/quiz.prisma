model Quiz {
  id        String @id @default(cuid())
  title     String
  description String?
  category String?
  quizData  Json
  createdBy String

  creator User @relation(fields:[createdBy],    references: [id] )

  liveQuizSessions LiveQuizSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
}