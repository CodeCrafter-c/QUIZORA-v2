enum Gender {
  male
  female
  other
}

enum AuthProvider {
  credentials
  google
  github
}

model User {
  id        String  @id @default(cuid())
  firstName String
  lastName  String?
  gender    Gender?
  email     String  @unique
  password  String?
  provider  AuthProvider @default(credentials)
  providerId String? @unique

  sessions         Session[]
  quizzes          Quiz[]
  liveQuizSessions LiveQuizSession[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}