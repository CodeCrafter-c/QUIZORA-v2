enum Gender {
  male
  female
  other
}

model User {
  id        String  @id @default(cuid())
  firstName String
  lastName  String?
  gender    Gender?
  email     String  @unique
  password  String?

  sessions         Session[]
  quizzes          Quiz[]
  liveQuizSessions LiveQuizSession[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}